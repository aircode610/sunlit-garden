# Local development settings. Don't edit this file to configure your machine:
# run `scripts/dev-env.sh` to create .env (git-ignored) from it, with real random secrets.
# Values marked __GENERATE__ are replaced by the script.

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=sunlit
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_DB=sunlit
POSTGRES_PORT=5433
# Used by sqlx (compile-time query checks and migrations) and by the app.
DATABASE_URL=postgres://sunlit:__POSTGRES_PASSWORD__@127.0.0.1:5433/sunlit

# --- Object storage (S3 API; Garage locally, R2/S3 when hosted) --------------
S3_ENDPOINT=http://127.0.0.1:3900
S3_PORT=3900
S3_REGION=garage
S3_BUCKET=texts
S3_ACCESS_KEY_ID=__GENERATE__
S3_SECRET_ACCESS_KEY=__GENERATE__

# --- Garage internals (local only) -------------------------------------------
GARAGE_ADMIN_PORT=3903
GARAGE_RPC_SECRET=__GENERATE__
GARAGE_ADMIN_TOKEN=__GENERATE__
GARAGE_METRICS_TOKEN=__GENERATE__
