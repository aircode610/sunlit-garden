{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-opus-5-5",
  // Hide the JetBrains work proxy models (from the global v1 config) in this project
  "providers": {
    "jb-claude": {
      "models": {
        "anthropic/claude-opus-5": { "disabled": true },
        "anthropic/claude-sonnet-5": { "disabled": true },
        "anthropic/claude-haiku-4-5": { "disabled": true }
      }
    },
    "jb-openai": {
      "models": {
        "openai/gpt-5.6-sol": { "disabled": true }
      }
    }
  },
  // V2 has no small_model: cheap background chores run as hidden agents, so point them at Haiku
  "agents": {
    "title": { "model": "anthropic/claude-haiku-5-5" },
    "summary": { "model": "anthropic/claude-haiku-5-5" }
  },
  "formatter": true,
  // Always load the dev vault's Home (current focus) and Decisions
  "instructions": ["~/grind/sunlit-garden-vault/Home.md", "~/grind/sunlit-garden-vault/Decisions.md"],
  "references": {
    "rune": {
      "repository": "anomalyco/rune",
      "branch": "dev",
      "description": "Rune UI framework source. Read examples/ and PLAN.md before using its API."
    },
    "vault": {
      "path": "~/grind/sunlit-garden-vault",
      "description": "Dev Obsidian vault: roadmap, module notes, Kanban tasks, architecture, decisions, open questions and session memory. Single source of truth for plans."
    }
  },
  // Allow everything; only pushing is blocked (last matching rule wins)
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git -C * push *", "effect": "deny" }
  ]
}
